{$DOMAIN} www.{$DOMAIN} {
    reverse_proxy finanzas:8000
}

# Webmin (corre en el HOST, puerto 10000, HTTPS con certificado autofirmado).
# Caddy alcanza el host vía host.docker.internal (extra_hosts en docker-compose).
webmin.{$DOMAIN} {
    reverse_proxy https://host.docker.internal:10000 {
        transport http {
            tls_insecure_skip_verify
        }
    }
}

# Portainer (contenedor). Se le habla por HTTP en el puerto interno 9000 a través
# de la red de Caddy, NO por host.docker.internal:9443: ese camino daba doble TLS
# lento y, sobre todo, el CSRF de Portainer 2.20+ rechazaba con "Forbidden -
# origin invalid" (recibía un Host interno en vez del dominio público).
# REQUISITO de despliegue: conectar el contenedor portainer a la red de Caddy
#   docker network connect <proyecto>_default portainer
# (p. ej. jsg-portfolio_default). Así Caddy resuelve "portainer" por nombre.
portainer.{$DOMAIN} {
    reverse_proxy portainer:9000 {
        header_up Host {host}
        header_up X-Forwarded-Host {host}
        header_up X-Forwarded-Proto https
    }
}
