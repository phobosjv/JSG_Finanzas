# Copiar a .env y rellenar los valores reales
# (este fichero SI se sube a git; .env NO)

# Ruta al fichero SQLite (en Docker lo sobreescribe docker-compose.yml)
DATABASE_URL=sqlite:///./finanzas.db

# Clave secreta para firmar cookies de sesion.
# Generar con: python -c "import secrets; print(secrets.token_hex(32))"
# OBLIGATORIO — la app no arranca sin este valor.
SECRET_KEY=cambia-esto-en-produccion

# Minutos de validez de la sesion (default: 10080 = 7 dias)
# ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Dominio para Caddy (proxy inverso con HTTPS automatico).
# Con un dominio real Caddy obtiene y renueva el certificado Let's Encrypt solo.
# Con 'localhost' sirve HTTP plano (util para pruebas locales con Docker).
DOMAIN=tudominio.com

# Origenes CORS permitidos (lista JSON).
# En produccion Docker el frontend lo sirve el propio FastAPI (mismo origen),
# por lo que normalmente no hace falta cambiar este valor.
# Solo necesario si accedes desde un dominio externo distinto al del servidor.
# ALLOWED_ORIGINS=["https://tu-dominio.com"]

# Marca la cookie de sesion como Secure (solo envia por HTTPS).
# OBLIGATORIO ponerlo a true cuando DOMAIN es un dominio real con certificado SSL.
# false = valido para acceso HTTP local (DOMAIN=localhost).
COOKIE_SECURE=true

# Activar logs detallados y reload de uvicorn — SIEMPRE false en produccion.
# DEBUG=false

# Usuario administrador por defecto.
# Se crea automáticamente en el primer arranque si no existe.
# Cambia la contraseña tras el primer login o pon valores vacíos para deshabilitar.
ADMIN_DEFAULT_USER=admin
ADMIN_DEFAULT_PASSWORD=admin1234
